# Shared
NODE_ENV=development

# API
PORT=4000
CLIENT_URL=http://localhost:5173
# Neon connection string. Get it from: https://console.neon.tech > your project > Connection details > Pooled connection
# Must include ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
SESSION_SECRET=replace-with-a-long-random-string

# Better Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-base64-string
BETTER_AUTH_URL=http://localhost:4000

# Web
VITE_API_URL=http://localhost:4000

# Realtime: set only in local dev to enable WebSocket sync via Socket.IO.
# Leave empty in production (Vercel) to fall back to 15s polling.
# When set, the client opens a WebSocket to this URL; when unset, no socket
# is opened and the same hooks invalidation runs on a 15s interval instead.
VITE_WS_URL=http://localhost:4000
